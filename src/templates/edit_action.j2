{% extends "base.html" %}
{% block title %}
    Edit Action
{% endblock title %}
{% block content %}
    <div class="form-container">
        <h1>Edit Action</h1>
        <form method="post">
            {{ form.csrf_token }}
            <div>
                {{ form.name.label }}
                {{ form.name(class="input-text") }}
                {% if form.name.errors %}<div class="error">{{ form.name.errors[0] }}</div>{% endif %}
            </div>
            <div>
                {{ form.kind.label }}
                {{ form.kind(class="input-text") }}
                {% if form.kind.errors %}<div class="error">{{ form.kind.errors[0] }}</div>{% endif %}
                {% if action.logs|length %}
                    <p class="form-hint">
                        Changing type converts the {{ action.logs|length }} existing
                        log(s): counts become readings, readings become counts.
                    </p>
                {% endif %}
            </div>
            <div>
                {{ form.unit.label }}
                {{ form.unit(class="input-text") }}
                {% if form.unit.errors %}<div class="error">{{ form.unit.errors[0] }}</div>{% endif %}
            </div>
            <div>
                {{ form.notes.label }}
                {{ form.notes(rows="4", class="input-textarea") }}
            </div>
            <div>
                {{ form.properties.label }}
                {{ form.properties(rows="6", class="input-textarea") }}
            </div>
            <div class="actions">
                {{ form.submit(class="btn btn-primary") }}
                <a href="{{ url_for('action.list_actions') }}" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
{% endblock content %}
